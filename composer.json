{
    "name": "focalcrm/service",
    "description": "Customer Service, Help Desk, Tickets, SLAs, and Knowledge Base for Focal CRM",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crm",
        "focalcrm",
        "helpdesk",
        "tickets",
        "sla",
        "knowledge-base"
    ],
    "homepage": "https://focalcrm.io",
    "support": {
        "issues": "https://github.com/focalcrm/focal/issues",
        "source": "https://github.com/focalcrm/focal"
    },
    "authors": [
        {
            "name": "CaskStack, LLC",
            "homepage": "https://focalcrm.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "focalcrm/core": "self.version",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Focal\\Service\\": "src/",
            "Focal\\Service\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Focal\\Service\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Focal\\Service\\ServiceHubServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
