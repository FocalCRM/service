{
    "name": "focalcrm/service",
    "description": "Customer Service, Help Desk, Tickets, SLAs, and Knowledge Base for Focal CRM",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Focal Team"
        }
    ],
    "require": {
        "php": "^8.3",
        "focalcrm/core": "self.version",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Focal\\Service\\": "src/",
            "Focal\\Service\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Focal\\Service\\ServiceHubServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
